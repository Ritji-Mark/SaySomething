# Base URL of the SaySomething backend API (no trailing slash).
# The app calls <VITE_API_URL>/api/... and loads evidence from <VITE_API_URL>/uploads/...
VITE_API_URL=http://localhost:5000

# Google OAuth Web Client ID (ends in .apps.googleusercontent.com).
# When empty, the "Sign in with Google" button is hidden and the app works normally.
# Must match GOOGLE_CLIENT_ID in the backend .env.
VITE_GOOGLE_CLIENT_ID=
