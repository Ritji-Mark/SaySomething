# ============================================================================
# SaySomething — backend environment (root .env)
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# ============================================================================

# Port the API listens on.
PORT=5000

# Set to "production" to lock CORS to CLIENT_ORIGIN. In development any
# localhost / 127.0.0.1 origin is accepted, so the exact Vite port doesn't matter.
NODE_ENV=development

# Allowed browser origin in production (e.g. https://app.example.com).
# Ignored in development.
CLIENT_ORIGIN=

# PostgreSQL (PostGIS) connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saysomething
DB_USER=postgres
DB_PASSWORD=

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=change-me

# Google OAuth Web Client ID (ends in .apps.googleusercontent.com).
# When empty, POST /api/auth/google returns 503 and Google sign-in is disabled.
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# Resend API key for transactional email (status/assignment notices + password
# reset). When empty, email is disabled (the app logs and skips each send).
# Get one at https://resend.com. This is a SECRET — never commit a real key.
RESEND_API_KEY=

# Verified sender for outgoing mail. Until you verify your own domain in Resend,
# use onboarding@resend.dev (test mode delivers only to your Resend account).
MAIL_FROM=SaySomething <onboarding@resend.dev>

# Public URL of the frontend, used to build links inside emails.
APP_ORIGIN=http://localhost:5173
